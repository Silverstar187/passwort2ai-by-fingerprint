#!/usr/bin/env bash
#
# p2ai — Passwort2AI by Fingerprint.
# Touch-ID-gated KeePass entry retrieval for terminals + AI agents.
#
# Master password lives in macOS Keychain. Each fetch:
#   1. If p2ai-agent is running → master from RAM cache (no Touch-ID)
#   2. Else → Touch-ID via LAContext → master from keychain
#   3. keepassxc-cli decrypts .kdbx and returns the entry value
#
# Usage:
#   p2ai setup                              one-time enroll master
#   p2ai fetch <entry>                      Touch-ID, password to pbcopy + auto-clear 30s
#   p2ai fetch <entry> --print              print to stdout (no pbcopy)
#   p2ai fetch <entry> --attr UserName      different attribute (default: Password)
#   p2ai fetch <entry> --export VAR         emit `export VAR=...` (use with eval $(p2ai fetch …))
#   p2ai add <entry> [-u USER] [-g [LEN]]   add new entry; -g auto-generates pw (default 24c)
#   p2ai add <entry> -p                     add entry with interactive password prompt
#   p2ai add <entry> --url URL --notes TXT  add with URL + notes fields
#   p2ai list [query]                       Touch-ID, list entries (filter optional)
#   p2ai unlock [--ttl SEC]                 Touch-ID, start agent, master in RAM (default 300s idle)
#   p2ai lock                               kill agent, clear master from RAM
#   p2ai status                             agent state + idle remaining
#   p2ai config                             show config + db path
#   p2ai -h                                 help
#
# Config:
#   $P2AI_DB                                .kdbx path (default ~/Passwörter.kdbx)
#   $P2AI_KEEPASSXC_CLI                     keepassxc-cli binary (default: auto-detect)
#   $P2AI_CLEAR_SECONDS                     pbcopy auto-clear delay (default 30)
#   $P2AI_AGENT_TTL                         agent idle TTL seconds (default 300)

set -euo pipefail

P2AI_CLEAR_SECONDS="${P2AI_CLEAR_SECONDS:-30}"
P2AI_KEEPASSXC_CLI="${P2AI_KEEPASSXC_CLI:-}"
P2AI_AGENT_TTL="${P2AI_AGENT_TTL:-300}"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
P2AI_MASTER_BIN="${P2AI_MASTER_BIN:-$SCRIPT_DIR/p2ai-master}"
P2AI_AGENT_BIN="${P2AI_AGENT_BIN:-$SCRIPT_DIR/p2ai-agent}"
P2AI_STATE_DIR="${P2AI_STATE_DIR:-$HOME/.local/state/p2ai}"
P2AI_SOCK="$P2AI_STATE_DIR/agent.sock"
P2AI_PID="$P2AI_STATE_DIR/agent.pid"
P2AI_DB_PATH_FILE="$P2AI_STATE_DIR/db.path"

# Resolve DB path: explicit env-var > saved path file > default
if [[ -z "${P2AI_DB:-}" && -r "$P2AI_DB_PATH_FILE" ]]; then
  P2AI_DB=$(<"$P2AI_DB_PATH_FILE")
fi
P2AI_DB="${P2AI_DB:-$HOME/Passwörter.kdbx}"

die() { printf 'p2ai: %s\n' "$*" >&2; exit 1; }

# Detect 2-char macOS UI language so Touch-ID reason matches dialog framing.
# Override via $P2AI_LANG=en|de|fr|...
p2ai_lang() {
  local lang="${P2AI_LANG:-}"
  if [[ -z "$lang" ]]; then
    lang=$(defaults read -g AppleLocale 2>/dev/null | head -1 | cut -c1-2 | tr A-Z a-z)
  fi
  [[ -n "$lang" ]] || lang="en"
  printf '%s' "$lang"
}

# Localized Touch-ID reason. Args: <key> [<arg>]
p2ai_reason() {
  local key="$1" arg="${2:-}" lang
  lang=$(p2ai_lang)
  case "$key:$lang" in
    unlock:de)  printf 'Master für Session entsperren' ;;
    unlock:fr)  printf 'Déverrouiller le master pour la session' ;;
    unlock:*)   printf 'Unlock master for session' ;;
    fetch:de)   printf 'Eintrag "%s" abrufen' "$arg" ;;
    fetch:fr)   printf "Récupérer l'entrée \"%s\"" "$arg" ;;
    fetch:*)    printf 'Fetch "%s"' "$arg" ;;
    add:de)     printf 'Eintrag "%s" hinzufügen' "$arg" ;;
    add:fr)     printf 'Ajouter l\047entrée "%s"' "$arg" ;;
    add:*)      printf 'Add "%s"' "$arg" ;;
    attachment:de) printf 'Anhang von "%s" abrufen' "$arg" ;;
    attachment:fr) printf 'Récupérer la pièce jointe de "%s"' "$arg" ;;
    attachment:*)  printf 'Fetch attachment of "%s"' "$arg" ;;
    list:de)    printf 'Einträge auflisten' ;;
    list:fr)    printf 'Lister les entrées' ;;
    list:*)     printf 'List entries' ;;
    *)          printf '%s' "$key" ;;
  esac
}

resolve_kpcli() {
  if [[ -n "$P2AI_KEEPASSXC_CLI" && -x "$P2AI_KEEPASSXC_CLI" ]]; then
    printf '%s' "$P2AI_KEEPASSXC_CLI"; return
  fi
  for c in "$HOME/bin/keepassxc-cli" "/Applications/KeePassXC.app/Contents/MacOS/keepassxc-cli" "/opt/homebrew/bin/keepassxc-cli" "/usr/local/bin/keepassxc-cli"; do
    [[ -x "$c" ]] && { printf '%s' "$c"; return; }
  done
  command -v keepassxc-cli 2>/dev/null && return
  die "keepassxc-cli not found. Install: brew install --cask keepassxc — or set P2AI_KEEPASSXC_CLI."
}

require_db() {
  [[ -r "$P2AI_DB" ]] || die "DB not readable: $P2AI_DB (set P2AI_DB)"
}

agent_running() {
  [[ -S "$P2AI_SOCK" && -r "$P2AI_PID" ]] || return 1
  local pid; pid=$(<"$P2AI_PID")
  kill -0 "$pid" 2>/dev/null
}

# Send a single command to the agent socket, return its response.
# Uses /dev/tcp-equivalent via nc (BSD nc supports -U).
agent_send() {
  local cmd="$1"
  agent_running || return 1
  printf '%s\n' "$cmd" | nc -U "$P2AI_SOCK" 2>/dev/null
}

# fetch_master <reason>
# Returns master via stdout. Uses agent if running, else Touch-ID.
fetch_master() {
  local reason="${1:-unlock KeePass master}"
  "$P2AI_MASTER_BIN" --reason "$reason"
}

pick_db_dialog() {
  # macOS native file picker via AppleScript. Returns POSIX path or empty.
  osascript <<'OSA' 2>/dev/null
  try
    set f to choose file with prompt "Select your KeePassXC database (.kdbx)" of type {"kdbx", "kdb"}
    return POSIX path of f
  on error number -128
    return ""
  end try
OSA
}

cmd_setup() {
  # 1. Master password enrollment (Swift CLI, TTY required)
  "$P2AI_MASTER_BIN" setup || return $?

  # 2. KeePass DB path — pick via file dialog if not yet configured
  mkdir -p "$P2AI_STATE_DIR"
  chmod 700 "$P2AI_STATE_DIR"
  local existing="$P2AI_DB"
  if [[ -r "$existing" ]]; then
    printf 'p2ai: using existing DB: %s\n' "$existing" >&2
  else
    printf 'p2ai: KeePass DB not found at %s\n' "$existing" >&2
    printf 'p2ai: opening file picker — choose your .kdbx ...\n' >&2
    local chosen; chosen=$(pick_db_dialog)
    if [[ -z "$chosen" ]]; then
      printf 'p2ai: cancelled. Set $P2AI_DB manually or run `p2ai setup` again.\n' >&2
      return 1
    fi
    if [[ ! -r "$chosen" ]]; then
      printf 'p2ai: chosen file not readable: %s\n' "$chosen" >&2
      return 1
    fi
    printf '%s' "$chosen" > "$P2AI_DB_PATH_FILE"
    chmod 600 "$P2AI_DB_PATH_FILE"
    printf 'p2ai: saved DB path → %s\n' "$chosen" >&2
  fi

  # 3. Quick smoke test: list root with master to verify both work
  printf 'p2ai: verifying master + DB ... (Touch-ID prompt)\n' >&2
  if p2ai_lang_test=$(P2AI_DB="$existing" "$0" list >/dev/null 2>&1); then
    printf 'p2ai: setup complete. Try `p2ai unlock` then `p2ai fetch <entry>`.\n' >&2
  else
    printf 'p2ai: master enrolled + DB path saved, but verification list failed. Check `p2ai list` manually.\n' >&2
  fi
}

cmd_unlock() {
  local ttl="$P2AI_AGENT_TTL"
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --ttl|-t) ttl="${2:?}"; shift 2 ;;
      *) die "unknown unlock arg: $1" ;;
    esac
  done
  mkdir -p "$P2AI_STATE_DIR"
  chmod 700 "$P2AI_STATE_DIR"
  if agent_running; then
    printf 'p2ai: agent already running.\n' >&2
    cmd_status; return
  fi
  # Touch-ID, get master, spawn agent in background, master via stdin.
  local master; master=$("$P2AI_MASTER_BIN" --reason "$(p2ai_reason unlock)") || die "auth failed"
  ( printf '%s' "$master" | nohup "$P2AI_AGENT_BIN" --ttl "$ttl" >/dev/null 2>&1 ) &
  disown
  master=""
  # Wait briefly for agent to bind socket + write pid
  local i
  for i in 1 2 3 4 5 6 7 8; do
    agent_running && break
    sleep 0.15
  done
  if agent_running; then
    printf 'p2ai: agent unlocked, idle TTL %ss.\n' "$ttl" >&2
  else
    die "agent failed to start"
  fi
}

cmd_lock() {
  if ! agent_running; then
    printf 'p2ai: no agent running.\n' >&2
    return 0
  fi
  agent_send EXIT >/dev/null 2>&1 || true
  sleep 0.1
  # Belt-and-suspenders: SIGTERM by pid
  if [[ -r "$P2AI_PID" ]]; then
    local pid; pid=$(<"$P2AI_PID")
    kill -0 "$pid" 2>/dev/null && kill -TERM "$pid" 2>/dev/null || true
  fi
  rm -f "$P2AI_SOCK" "$P2AI_PID"
  printf 'p2ai: agent locked.\n' >&2
}

cmd_status() {
  if ! agent_running; then
    printf 'p2ai: agent not running.\n'
    return 0
  fi
  local resp; resp=$(agent_send STATUS)
  printf '%s\n' "${resp:-no response}"
}

cmd_config() {
  printf 'P2AI_DB:               %s\n' "$P2AI_DB"
  printf 'P2AI_KEEPASSXC_CLI:    %s\n' "$(resolve_kpcli)"
  printf 'P2AI_CLEAR_SECONDS:    %s\n' "$P2AI_CLEAR_SECONDS"
  printf 'P2AI_AGENT_TTL:        %s\n' "$P2AI_AGENT_TTL"
  printf 'master-bin:            %s\n' "$P2AI_MASTER_BIN"
  printf 'agent-bin:             %s\n' "$P2AI_AGENT_BIN"
  printf 'state dir:             %s\n' "$P2AI_STATE_DIR"
  printf 'db readable:           %s\n' "$([[ -r "$P2AI_DB" ]] && echo yes || echo NO)"
  printf 'agent running:         %s\n' "$(agent_running && echo yes || echo no)"
}

cmd_list() {
  require_db
  local kpcli; kpcli=$(resolve_kpcli)
  local query="${1:-}"
  local master; master=$(fetch_master "$(p2ai_reason list)") || die "auth failed"
  if [[ -n "$query" ]]; then
    printf '%s' "$master" | "$kpcli" ls -R "$P2AI_DB" 2>/dev/null | grep -i -- "$query" || true
  else
    printf '%s' "$master" | "$kpcli" ls -R "$P2AI_DB" 2>/dev/null
  fi
  master=""
}

cmd_gtoken() {
  local entry="" scope="https://www.googleapis.com/auth/cloud-platform" mode="print" var=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --scope|-s)   scope="$2"; shift 2 ;;
      --print|-p)   mode="print"; shift ;;
      --pbcopy|-c)  mode="pbcopy"; shift ;;
      --export|-e)  mode="export"; var="${2:?}"; shift 2 ;;
      -h|--help)
        cat <<USAGE
p2ai gtoken <sa-entry> [options]
  Mint a Google OAuth access token from a Service-Account JSON entry.
  SA JSON must be in the entry's Notes field (a {...} block).
  --scope, -s SCOPE   default: cloud-platform. Aliases: drive, drive.readonly,
                      gmail, sheets, calendar, etc. Full URL also accepted.
  --print, -p         token to stdout (default)
  --pbcopy, -c        token to clipboard, auto-clear after \$P2AI_CLEAR_SECONDS
  --export, -e VAR    emit 'export VAR=...' for use with eval
USAGE
        return 0 ;;
      -*) die "unknown gtoken flag: $1" ;;
      *)  [[ -z "$entry" ]] && entry="$1" || die "extra arg: $1"; shift ;;
    esac
  done
  [[ -n "$entry" ]] || die "usage: p2ai gtoken <sa-entry> [--scope X] [--print|--pbcopy|--export VAR]"

  # Resolve scope shortcuts to full URL
  case "$scope" in
    https://*) ;;
    drive)               scope="https://www.googleapis.com/auth/drive" ;;
    drive.readonly)      scope="https://www.googleapis.com/auth/drive.readonly" ;;
    gmail)               scope="https://www.googleapis.com/auth/gmail.readonly" ;;
    sheets)              scope="https://www.googleapis.com/auth/spreadsheets" ;;
    calendar)            scope="https://www.googleapis.com/auth/calendar" ;;
    cloud-platform|cloud) scope="https://www.googleapis.com/auth/cloud-platform" ;;
    *) scope="https://www.googleapis.com/auth/$scope" ;;
  esac

  command -v gcloud >/dev/null 2>&1 || die "gcloud CLI not found (https://cloud.google.com/sdk/docs/install)"

  local tmpdir; tmpdir=$(mktemp -d -t p2ai-gtoken)
  trap "rm -rf -P '$tmpdir' 2>/dev/null" EXIT

  # 1. Fetch SA Notes → file (no chat-leak via stdout-redirect)
  local raw="$tmpdir/raw" json="$tmpdir/sa.json" tok="$tmpdir/tok"
  if ! "$0" fetch "$entry" --attr Notes --print > "$raw" 2>/dev/null; then
    die "could not fetch '$entry' Notes attr"
  fi

  # 2. Extract first {...} JSON block
  python3 - <<PY > "$json" 2>/dev/null
import re, json, sys
raw=open("$raw").read()
m=re.search(r'\{[\s\S]*\}', raw)
if not m: sys.exit(1)
try:
    obj=json.loads(m.group(0))
    if 'private_key' not in obj or 'client_email' not in obj: sys.exit(2)
    json.dump(obj, sys.stdout)
except Exception:
    sys.exit(3)
PY
  [[ -s "$json" ]] || die "could not extract SA JSON from '$entry' Notes (need {...} with private_key + client_email)"
  chmod 600 "$json"

  # 3. Activate SA + print access token
  CLOUDSDK_PYTHON_SUPPRESS_WARNINGS=1 gcloud auth activate-service-account --key-file="$json" --quiet >/dev/null 2>&1 \
    || die "gcloud auth activate-service-account failed"
  CLOUDSDK_PYTHON_SUPPRESS_WARNINGS=1 gcloud auth print-access-token --scopes="$scope" > "$tok" 2>/dev/null \
    || die "gcloud print-access-token failed (scope: $scope)"
  [[ -s "$tok" ]] || die "empty token returned"

  local token; token=$(<"$tok")
  token="${token//$'\n'/}"

  # 4. Output
  case "$mode" in
    print)
      printf '%s\n' "$token"
      ;;
    pbcopy)
      printf '%s' "$token" | pbcopy
      printf 'p2ai: gtoken (%s) in clipboard, auto-clear in %ss.\n' "$scope" "$P2AI_CLEAR_SECONDS" >&2
      ( sleep "$P2AI_CLEAR_SECONDS"; if [[ "$(pbpaste)" == "$token" ]]; then printf '' | pbcopy; fi ) >/dev/null 2>&1 &
      disown
      ;;
    export)
      printf "export %s='%s'\n" "$var" "$token"
      ;;
  esac
  token=""
}

cmd_attachment() {
  local entry="" name="" outfile="" mode="auto"
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -o|--output)  outfile="${2:?}"; mode="file"; shift 2 ;;
      --print|-p)   mode="print"; shift ;;
      --pbcopy|-c)  mode="pbcopy"; shift ;;
      -h|--help)
        cat <<USAGE
p2ai attachment <entry> [<attachment-name>] [options]
  no name              → list attachment names of entry
  <name>               → export to stdout (default if attachment is text)
  <name> -o FILE       → export to file
  <name> --pbcopy      → copy to clipboard (auto-clear)
  <name> --print       → force stdout even if binary
USAGE
        return 0 ;;
      -*) die "unknown attachment flag: $1" ;;
      *)  if [[ -z "$entry" ]]; then entry="$1"
          elif [[ -z "$name" ]]; then name="$1"
          else die "extra arg: $1"; fi
          shift ;;
    esac
  done
  [[ -n "$entry" ]] || die "usage: p2ai attachment <entry> [<name>] [-o FILE | --print | --pbcopy]"
  require_db
  local kpcli; kpcli=$(resolve_kpcli)
  local master; master=$(fetch_master "$(p2ai_reason attachment "$entry")") || die "auth failed"

  if [[ -z "$name" ]]; then
    # List attachments
    printf '%s\n' "$master" | "$kpcli" show --show-attachments "$P2AI_DB" "$entry" 2>/dev/null \
      | awk '/^Attachments:/{f=1; next} f && /^[[:space:]]+/{print substr($0, index($0,$1))}'
    master=""
    return 0
  fi

  if [[ "$mode" == "file" ]]; then
    printf '%s\n' "$master" | "$kpcli" attachment-export "$P2AI_DB" "$entry" "$name" "$outfile" 2>&1 | tail -1
    master=""
    [[ -r "$outfile" ]] && printf 'p2ai: saved → %s (%s bytes)\n' "$outfile" "$(wc -c < "$outfile" | tr -d ' ')" >&2
    return 0
  fi

  # Default mode: depends on size + content type. Fetch to memory.
  local content
  content=$(printf '%s\n' "$master" | "$kpcli" attachment-export --stdout "$P2AI_DB" "$entry" "$name" 2>/dev/null) || die "attachment '$name' not found in '$entry'"
  master=""
  [[ -n "$content" ]] || die "attachment '$name' empty"

  case "$mode" in
    print)   printf '%s\n' "$content" ;;
    pbcopy)
      printf '%s' "$content" | pbcopy
      printf 'p2ai: attachment %s/%s in clipboard, auto-clear in %ss.\n' "$entry" "$name" "$P2AI_CLEAR_SECONDS" >&2
      ( sleep "$P2AI_CLEAR_SECONDS"; if [[ "$(pbpaste)" == "$content" ]]; then printf '' | pbcopy; fi ) >/dev/null 2>&1 &
      disown
      ;;
    auto)
      # Heuristic: if content looks text (no NULs in first 8KB), print; else require explicit mode
      if printf '%s' "${content:0:8192}" | LC_ALL=C grep -q $'\0'; then
        die "attachment '$name' is binary — use -o FILE to save"
      fi
      printf '%s\n' "$content"
      ;;
  esac
}

cmd_add() {
  local entry="" user="" url="" notes="" gen_len="" prompt_pw=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -u|--username)  user="${2:?}"; shift 2 ;;
      --url)          url="${2:?}"; shift 2 ;;
      --notes|--note) notes="${2:?}"; shift 2 ;;
      -g|--generate)  gen_len="${2:-24}"
                      [[ "$gen_len" =~ ^[0-9]+$ ]] || { gen_len=24; shift 1; continue; }
                      shift 2 ;;
      -p|--password)  prompt_pw=1; shift ;;
      -h|--help)
        cat <<USAGE
p2ai add <entry> [options]
  -u, --username USER     username for entry
  --url URL               URL field
  --notes TEXT            notes field
  -g, --generate [LEN]    auto-generate password (default length 24)
  -p, --password          prompt interactively for password (hidden)
Default if neither -g nor -p: -g 24.
USAGE
        return 0 ;;
      -*) die "unknown add flag: $1" ;;
      *)  [[ -z "$entry" ]] && entry="$1" || die "extra arg: $1"; shift ;;
    esac
  done
  [[ -n "$entry" ]] || die "usage: p2ai add <entry> [-u user] [-g [LEN]] [-p] [--url URL] [--notes TEXT]"
  require_db
  [[ -w "$P2AI_DB" ]] || die "DB not writable: $P2AI_DB"
  local kpcli; kpcli=$(resolve_kpcli)

  # Default: auto-generate 24-char password
  if [[ -z "$gen_len" && $prompt_pw -eq 0 ]]; then
    gen_len=24
  fi

  local master; master=$(fetch_master "$(p2ai_reason add "$entry")") || die "auth failed"

  # Build keepassxc-cli args
  local args=(add)
  [[ -n "$user" ]]  && args+=(-u "$user")
  [[ -n "$url" ]]   && args+=(--url "$url")
  [[ -n "$notes" ]] && args+=(--notes "$notes")
  if [[ -n "$gen_len" ]]; then
    args+=(-g -L "$gen_len" -l -U -n -s --exclude-similar)
  elif [[ $prompt_pw -eq 1 ]]; then
    args+=(-p)
  fi
  args+=("$P2AI_DB" "$entry")

  # Run keepassxc-cli — master via stdin, entry-pwd prompt on TTY (if -p)
  if printf '%s\n' "$master" | "$kpcli" "${args[@]}"; then
    master=""
    printf 'p2ai: added "%s" to %s\n' "$entry" "$P2AI_DB" >&2
  else
    master=""
    die "keepassxc-cli add failed"
  fi
}

cmd_fetch() {
  local entry="" attr="Password" mode="pbcopy" var=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --print|-p)   mode="print"; shift ;;
      --attr|-a)    attr="${2:?}"; shift 2 ;;
      --export|-e)  mode="export"; var="${2:?}"; shift 2 ;;
      --no-clear|-n) mode="${mode}-noclear"; shift ;;
      -*)           die "unknown flag: $1" ;;
      *)            [[ -z "$entry" ]] && entry="$1" || die "extra arg: $1"; shift ;;
    esac
  done
  [[ -n "$entry" ]] || die "usage: p2ai fetch <entry> [--attr X] [--print|--export VAR]"
  require_db
  local kpcli; kpcli=$(resolve_kpcli)

  # Touch-ID dialog reason includes entry name so user knows what's asked.
  local reason
  reason=$(p2ai_reason fetch "$entry")
  local master; master=$(fetch_master "$reason") || die "auth failed"

  # No `tail -1` — chops multiline attrs (Notes, custom fields). keepassxc-cli
  # `show -s -a X` outputs the raw value (no prompt with -s). Bash $() trims
  # trailing newlines automatically.
  local secret
  secret=$(printf '%s' "$master" | "$kpcli" show -s -a "$attr" "$P2AI_DB" "$entry" 2>/dev/null) || die "entry not found: $entry"
  master=""
  [[ -n "$secret" ]] || die "empty value for $entry / $attr"

  case "$mode" in
    print|print-noclear)
      printf '%s\n' "$secret"
      ;;
    export|export-noclear)
      local esc; esc=$(printf '%s' "$secret" | sed "s/'/'\\\\''/g")
      printf "export %s='%s'\n" "$var" "$esc"
      ;;
    pbcopy)
      printf '%s' "$secret" | pbcopy
      printf 'p2ai: %s/%s in clipboard, auto-clear in %ss.\n' "$entry" "$attr" "$P2AI_CLEAR_SECONDS" >&2
      (
        sleep "$P2AI_CLEAR_SECONDS"
        if [[ "$(pbpaste)" == "$secret" ]]; then
          printf '' | pbcopy
        fi
      ) >/dev/null 2>&1 &
      disown
      ;;
    pbcopy-noclear)
      printf '%s' "$secret" | pbcopy
      printf 'p2ai: %s/%s in clipboard.\n' "$entry" "$attr" >&2
      ;;
  esac
}

main() {
  local cmd="${1:-}"; [[ $# -gt 0 ]] && shift || true
  case "$cmd" in
    setup)                  cmd_setup "$@" ;;
    fetch|f|get)            cmd_fetch "$@" ;;
    add|new)                cmd_add "$@" ;;
    attachment|attach|att)  cmd_attachment "$@" ;;
    gtoken|gcp-token)       cmd_gtoken "$@" ;;
    list|ls)                cmd_list "$@" ;;
    unlock|u)         cmd_unlock "$@" ;;
    lock|l)           cmd_lock "$@" ;;
    status|s)         cmd_status "$@" ;;
    config|cfg)       cmd_config ;;
    -h|--help|help|"")
      sed -n '5,32p' "$0" | sed 's/^# \{0,1\}//'
      ;;
    *) die "unknown command: $cmd (try: p2ai -h)" ;;
  esac
}

main "$@"
