#!/usr/bin/env bash
#
# p2ai — Passwort2AI by Fingerprint.
# Touch-ID-gated KeePass entry retrieval for terminals + AI agents.
#
# Master password lives in macOS Keychain. Each fetch:
#   1. If p2ai-agent is running → master from RAM cache (no Touch-ID)
#   2. Else → Touch-ID via LAContext → master from keychain
#   3. keepassxc-cli decrypts .kdbx and returns the entry value
#
# Usage:
#   p2ai setup                              one-time enroll master
#   p2ai run -e VAR='<entry>' -- <cmd>      env-injection (recommended for tool calls)
#   p2ai fetch <entry>                      Touch-ID, password → pbcopy + auto-clear 30s
#   p2ai fetch <entry> --attr UserName      different attribute (default: Password)
#   p2ai add <entry> [-u USER] [-g [LEN]]   add new entry; -g auto-generates pw (default 24c)
#   p2ai add <entry> -p                     add entry with interactive password prompt
#   p2ai add <entry> --url URL --notes TXT  add with URL + notes fields
#   p2ai edit <entry> [opts]                update fields (-u/--url/--notes/-t/-g/-p)
#   p2ai rm <entry> [-f]                    delete entry (confirm unless -f)
#   p2ai mv <entry> <group>                 move entry to another group
#   p2ai otp <entry>                        TOTP → pbcopy + auto-clear (or --export VAR)
#   p2ai list [query]                       Touch-ID, list entries (filter optional)
#   p2ai unlock [--mode session|per-entry]  Touch-ID, start agent
#                  [--ttl SEC]                  default mode=session, ttl=300s idle
#   p2ai lock                               kill agent, clear master from RAM
#   p2ai status                             agent state + idle remaining
#   p2ai config                             show config + db path
#   p2ai -h                                 help
#
# IMPORTANT: --print, -o FILE, and --export are removed from fetch/otp/gtoken/
# attachment to prevent transcript leaks in AI-agent shells. The two safe
# egress paths are: (1) pbcopy with auto-clear (default), (2) `p2ai run` for
# env-injection — secret enters only the target command's environment.
#
# Exit codes (stable contract for AI-agent retry logic):
#   0   success
#   1   generic error / usage
#   2   tool dependency missing (e.g. keepassxc-cli not in PATH)
#   3   entry not found / DB read error
#   130 SIGINT — user cancelled Touch-ID prompt
#
# Config:
#   $P2AI_DB                                .kdbx path (default ~/passwords.kdbx)
#   $P2AI_KEEPASSXC_CLI                     keepassxc-cli binary (default: auto-detect)
#   $P2AI_CLEAR_SECONDS                     pbcopy auto-clear delay (default 30)
#   $P2AI_AGENT_TTL                         agent idle TTL seconds (default 300)

set -euo pipefail

P2AI_CLEAR_SECONDS="${P2AI_CLEAR_SECONDS:-30}"
P2AI_KEEPASSXC_CLI="${P2AI_KEEPASSXC_CLI:-}"
P2AI_AGENT_TTL="${P2AI_AGENT_TTL:-300}"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
P2AI_MASTER_BIN="${P2AI_MASTER_BIN:-$SCRIPT_DIR/p2ai-master}"
P2AI_AGENT_BIN="${P2AI_AGENT_BIN:-$SCRIPT_DIR/p2ai-agent}"
P2AI_STATE_DIR="${P2AI_STATE_DIR:-$HOME/.local/state/p2ai}"
P2AI_SOCK="$P2AI_STATE_DIR/agent.sock"
P2AI_PID="$P2AI_STATE_DIR/agent.pid"
P2AI_DB_PATH_FILE="$P2AI_STATE_DIR/db.path"

# Resolve DB path: explicit env-var > saved path file > default
if [[ -z "${P2AI_DB:-}" && -r "$P2AI_DB_PATH_FILE" ]]; then
  P2AI_DB=$(<"$P2AI_DB_PATH_FILE")
fi
P2AI_DB="${P2AI_DB:-$HOME/passwords.kdbx}"

die() { printf 'p2ai: %s\n' "$*" >&2; exit 1; }

# Detect 2-char macOS UI language so Touch-ID reason matches dialog framing.
# Override via $P2AI_LANG=en|de|fr|...
p2ai_lang() {
  local lang="${P2AI_LANG:-}"
  if [[ -z "$lang" ]]; then
    lang=$(defaults read -g AppleLocale 2>/dev/null | head -1 | cut -c1-2 | tr A-Z a-z)
  fi
  [[ -n "$lang" ]] || lang="en"
  printf '%s' "$lang"
}

# Localized Touch-ID reason. Args: <key> [<arg>]
p2ai_reason() {
  local key="$1" arg="${2:-}" lang
  lang=$(p2ai_lang)
  case "$key:$lang" in
    unlock:de)  printf 'Master für Session entsperren' ;;
    unlock:fr)  printf 'Déverrouiller le master pour la session' ;;
    unlock:*)   printf 'Unlock master for session' ;;
    fetch:de)   printf 'Eintrag "%s" abrufen' "$arg" ;;
    fetch:fr)   printf "Récupérer l'entrée \"%s\"" "$arg" ;;
    fetch:*)    printf 'Fetch "%s"' "$arg" ;;
    add:de)     printf 'Eintrag "%s" hinzufügen' "$arg" ;;
    add:fr)     printf 'Ajouter l\047entrée "%s"' "$arg" ;;
    add:*)      printf 'Add "%s"' "$arg" ;;
    attachment:de) printf 'Anhang von "%s" abrufen' "$arg" ;;
    attachment:fr) printf 'Récupérer la pièce jointe de "%s"' "$arg" ;;
    attachment:*)  printf 'Fetch attachment of "%s"' "$arg" ;;
    list:de)    printf 'Einträge auflisten' ;;
    list:fr)    printf 'Lister les entrées' ;;
    list:*)     printf 'List entries' ;;
    rm:de)      printf 'Eintrag "%s" löschen' "$arg" ;;
    rm:fr)      printf 'Supprimer l\047entrée "%s"' "$arg" ;;
    rm:*)       printf 'Remove "%s"' "$arg" ;;
    edit:de)    printf 'Eintrag "%s" bearbeiten' "$arg" ;;
    edit:fr)    printf 'Modifier l\047entrée "%s"' "$arg" ;;
    edit:*)     printf 'Edit "%s"' "$arg" ;;
    mv:de)      printf 'Eintrag "%s" verschieben' "$arg" ;;
    mv:fr)      printf 'Déplacer l\047entrée "%s"' "$arg" ;;
    mv:*)       printf 'Move "%s"' "$arg" ;;
    otp:de)     printf 'TOTP-Code für "%s"' "$arg" ;;
    otp:fr)     printf 'Code TOTP pour "%s"' "$arg" ;;
    otp:*)      printf 'TOTP for "%s"' "$arg" ;;
    *)          printf '%s' "$key" ;;
  esac
}

resolve_kpcli() {
  if [[ -n "$P2AI_KEEPASSXC_CLI" && -x "$P2AI_KEEPASSXC_CLI" ]]; then
    printf '%s' "$P2AI_KEEPASSXC_CLI"; return
  fi
  for c in "$HOME/bin/keepassxc-cli" "/Applications/KeePassXC.app/Contents/MacOS/keepassxc-cli" "/opt/homebrew/bin/keepassxc-cli" "/usr/local/bin/keepassxc-cli"; do
    [[ -x "$c" ]] && { printf '%s' "$c"; return; }
  done
  command -v keepassxc-cli 2>/dev/null && return
  die "keepassxc-cli not found. Install: brew install --cask keepassxc — or set P2AI_KEEPASSXC_CLI."
}

require_db() {
  [[ -r "$P2AI_DB" ]] || die "DB not readable: $P2AI_DB (set P2AI_DB)"
}

agent_running() {
  [[ -S "$P2AI_SOCK" && -r "$P2AI_PID" ]] || return 1
  local pid; pid=$(<"$P2AI_PID")
  kill -0 "$pid" 2>/dev/null
}

# Send a single command to the agent socket, return its response.
# Uses /dev/tcp-equivalent via nc (BSD nc supports -U).
agent_send() {
  local cmd="$1"
  agent_running || return 1
  printf '%s\n' "$cmd" | nc -U "$P2AI_SOCK" 2>/dev/null
}

# Send command + raw payload to agent (for PUTENTRY).
# agent_send_with_body "PUTENTRY foo:Password" <<< "$secret"
agent_send_with_body() {
  local cmd="$1"
  agent_running || return 1
  { printf '%s\n' "$cmd"; cat; } | nc -U "$P2AI_SOCK" 2>/dev/null
}

agent_mode() {
  agent_send "MODE" 2>/dev/null | tr -d '\n'
}

# fetch_master <reason>
# Returns master via stdout. Asks agent first; on MISS does Touch-ID.
# Touch-ID prompt is bounded by $P2AI_AUTH_TIMEOUT (default 30s) so an
# unattended laptop doesn't hang an AI-agent loop forever.
fetch_master() {
  local reason="${1:-unlock KeePass master}"
  if agent_running; then
    local resp; resp=$(agent_send "GET")
    if [[ -n "$resp" && "$resp" != "MISS" ]]; then
      printf '%s' "$resp"
      return 0
    fi
  fi
  local timeout="${P2AI_AUTH_TIMEOUT:-30}"
  # Process-substitution fd → read -t with -d '' so we get the FULL master
  # (including any embedded newlines) up to EOF or the timeout, never
  # touching disk. read returns nonzero on EOF-without-delim but $master
  # is populated — we check the var, not the rc.
  exec 9< <("$P2AI_MASTER_BIN" --reason "$reason")
  local master=""
  IFS= read -r -t "$timeout" -d '' master <&9 || true
  exec 9<&-
  if [[ -n "$master" ]]; then
    # Strip a single trailing newline if present (Swift print() adds one)
    [[ "${master: -1}" == $'\n' ]] && master="${master%$'\n'}"
    printf '%s' "$master"
    return 0
  fi
  printf 'p2ai: Touch-ID timeout after %ss — user idle?\n' "$timeout" >&2
  return 1
}


pick_db_dialog() {
  # macOS native file picker via AppleScript. Returns POSIX path or empty.
  osascript <<'OSA' 2>/dev/null
  try
    set f to choose file with prompt "Select your KeePassXC database (.kdbx)" of type {"kdbx", "kdb"}
    return POSIX path of f
  on error number -128
    return ""
  end try
OSA
}

cmd_setup() {
  printf '\n'
  printf '  p2ai — Passwort2AI by Fingerprint\n'
  printf '  ══════════════════════════════════════════════════════════════\n'
  printf '  One-time setup. Takes about 30 seconds.\n'
  printf '\n'
  printf '  What happens:\n'
  printf '    1. You pick a master password (stored in Keychain)\n'
  printf '    2. macOS asks for Keychain permission → click "Always Allow"\n'
  printf '    3. Your password database is created automatically\n'
  printf '    4. Touch ID confirmed — you'\''re done\n'
  printf '  ══════════════════════════════════════════════════════════════\n'
  printf '\n'

  # 1. Master password enrollment (Swift CLI, TTY required)
  "$P2AI_MASTER_BIN" setup || return $?

  # 2. KeePass DB — auto-create if not yet present
  mkdir -p "$P2AI_STATE_DIR"
  chmod 700 "$P2AI_STATE_DIR"
  local existing="$P2AI_DB"
  if [[ -r "$existing" ]]; then
    printf 'p2ai: using existing DB: %s\n' "$existing" >&2
  else
    local kpcli; kpcli=$(resolve_kpcli)
    printf 'p2ai: no DB found — creating new database at %s\n' "$existing" >&2
    # Fetch master from keychain (just enrolled above) to create DB with same password
    local master; master=$("$P2AI_MASTER_BIN" --reason "Create KeePass database") || {
      printf 'p2ai: Touch-ID cancelled — cannot create DB.\n' >&2; return 1
    }
    printf '%s\n%s\n' "$master" "$master" | "$kpcli" db-create -p "$existing" >/dev/null 2>&1 || {
      master=""
      printf 'p2ai: failed to create DB at %s\n' "$existing" >&2; return 1
    }
    master=""
    printf '%s' "$existing" > "$P2AI_DB_PATH_FILE"
    chmod 600 "$P2AI_DB_PATH_FILE"
    printf 'p2ai: database created and saved → %s\n' "$existing" >&2
  fi

  # 3. Quick smoke test: list root with master to verify both work
  printf 'p2ai: verifying master + DB ... (Touch-ID prompt)\n' >&2
  if P2AI_DB="$existing" "$0" list >/dev/null 2>&1; then
    printf 'p2ai: setup complete. Try `p2ai unlock` then `p2ai fetch <entry>`.\n' >&2
  else
    printf 'p2ai: master enrolled + DB created, but verification failed. Run `p2ai list` to debug.\n' >&2
  fi
}

cmd_unlock() {
  local ttl="$P2AI_AGENT_TTL" mode="session"
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --ttl|-t)  ttl="${2:?}"; shift 2 ;;
      --mode|-m) mode="${2:?}"; shift 2 ;;
      session|per-entry) mode="$1"; shift ;;
      *) die "unknown unlock arg: $1 (try --mode session|per-entry --ttl SEC)" ;;
    esac
  done
  case "$mode" in session|per-entry) ;; *) die "mode must be session or per-entry" ;; esac

  mkdir -p "$P2AI_STATE_DIR"
  chmod 700 "$P2AI_STATE_DIR"
  if agent_running; then
    printf 'p2ai: agent already running.\n' >&2
    cmd_status; return
  fi

  if [[ "$mode" == "session" ]]; then
    # Touch-ID upfront; master to agent via stdin
    local master; master=$("$P2AI_MASTER_BIN" --reason "$(p2ai_reason unlock)") || die "auth failed"
    ( printf '%s' "$master" | nohup "$P2AI_AGENT_BIN" --mode session --ttl "$ttl" >/dev/null 2>&1 ) &
    disown
    master=""
  else
    # per-entry: no upfront Touch-ID, agent ready to cache entries on first fetch
    ( nohup "$P2AI_AGENT_BIN" --mode per-entry --ttl "$ttl" </dev/null >/dev/null 2>&1 ) &
    disown
  fi

  local i
  for i in 1 2 3 4 5 6 7 8; do
    agent_running && break
    sleep 0.15
  done
  if agent_running; then
    printf 'p2ai: agent unlocked (mode=%s, idle TTL %ss).\n' "$mode" "$ttl" >&2
  else
    die "agent failed to start"
  fi
}

cmd_lock() {
  if ! agent_running; then
    printf 'p2ai: no agent running.\n' >&2
    return 0
  fi
  agent_send EXIT >/dev/null 2>&1 || true
  sleep 0.1
  # Belt-and-suspenders: SIGTERM by pid
  if [[ -r "$P2AI_PID" ]]; then
    local pid; pid=$(<"$P2AI_PID")
    kill -0 "$pid" 2>/dev/null && kill -TERM "$pid" 2>/dev/null || true
  fi
  rm -f "$P2AI_SOCK" "$P2AI_PID"
  printf 'p2ai: agent locked.\n' >&2
}

cmd_status() {
  if ! agent_running; then
    printf 'p2ai: agent not running.\n'
    return 0
  fi
  local resp; resp=$(agent_send STATUS)
  printf '%s\n' "${resp:-no response}"
}

cmd_config() {
  printf 'P2AI_DB:               %s\n' "$P2AI_DB"
  printf 'P2AI_KEEPASSXC_CLI:    %s\n' "$(resolve_kpcli)"
  printf 'P2AI_CLEAR_SECONDS:    %s\n' "$P2AI_CLEAR_SECONDS"
  printf 'P2AI_AGENT_TTL:        %s\n' "$P2AI_AGENT_TTL"
  printf 'master-bin:            %s\n' "$P2AI_MASTER_BIN"
  printf 'agent-bin:             %s\n' "$P2AI_AGENT_BIN"
  printf 'state dir:             %s\n' "$P2AI_STATE_DIR"
  printf 'db readable:           %s\n' "$([[ -r "$P2AI_DB" ]] && echo yes || echo NO)"
  printf 'agent running:         %s\n' "$(agent_running && echo yes || echo no)"
}

cmd_list() {
  require_db
  local kpcli; kpcli=$(resolve_kpcli)
  local query="" json=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --json|-j) json=1; shift ;;
      -h|--help)
        cat <<USAGE
p2ai list [query] [--json]
  List entry paths (names only, never values).
  --json, -j    emit JSON array: [{"path":"Group/Title","group":"Group","title":"Title"}]
USAGE
        return 0 ;;
      -*) die "unknown list flag: $1" ;;
      *)  [[ -z "$query" ]] && query="$1" || die "extra arg: $1"; shift ;;
    esac
  done
  local master; master=$(fetch_master "$(p2ai_reason list)") || die "auth failed"
  local lines
  if [[ -n "$query" ]]; then
    lines=$(printf '%s' "$master" | "$kpcli" ls -R "$P2AI_DB" 2>/dev/null | grep -i -- "$query" || true)
  else
    lines=$(printf '%s' "$master" | "$kpcli" ls -R "$P2AI_DB" 2>/dev/null)
  fi
  master=""

  if [[ "$json" -eq 1 ]]; then
    # Emit JSON. Trim group-header lines (end in /) — those are metadata, not entries.
    printf '%s\n' "$lines" | python3 -c '
import json, sys
out = []
group = ""
for line in sys.stdin.read().splitlines():
    s = line.rstrip()
    if not s: continue
    if s.endswith("/"):
        group = s.rstrip("/")
        continue
    title = s.lstrip()
    indent = len(s) - len(title)
    path = (group + "/" + title) if (group and indent > 0) else title
    out.append({"path": path, "group": group if indent > 0 else "", "title": title})
print(json.dumps(out, ensure_ascii=False))
'
  else
    printf '%s\n' "$lines"
  fi
}

cmd_system_prompt() {
  # Emit AI-agent rules markdown. Pipe into .cursorrules / CLAUDE.md / etc.
  local target="generic"
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --target|-t)  target="${2:?}"; shift 2 ;;
      -h|--help)
        cat <<USAGE
p2ai system-prompt [--target generic|claude|cursor|aider|cline]
  Emit secrets-management rules markdown for AI coding agents.
  Pipe into the agent's rules file (.cursorrules, CLAUDE.md, .aider.conf.yml, etc.).

  Examples:
    p2ai system-prompt > .cursorrules
    p2ai system-prompt --target claude >> CLAUDE.md
USAGE
        return 0 ;;
      -*) die "unknown system-prompt flag: $1" ;;
      *)  die "extra arg: $1" ;;
    esac
  done

  case "$target" in
    generic|claude|cursor|aider|cline) ;;
    *) die "--target must be: generic, claude, cursor, aider, or cline" ;;
  esac

  cat <<'PROMPT'
# Secrets management (passwort2ai)

This project uses `p2ai` (passwort2ai-by-fingerprint) — a Touch-ID-gated
KeePass-CLI wrapper that keeps secrets out of the chat transcript.

## Hard rules

- **NEVER** paste a secret into the chat. Not full, not truncated, not masked.
- **NEVER** use `eval "$(p2ai fetch ... --export VAR)"`. That pattern is removed.
- **NEVER** use `--print`, `-o FILE` (for fetch), or `--export` flags.
- **NEVER** echo a fetched secret to stdout in any form.

## Required pattern — `p2ai run`

For every tool invocation that needs a secret in env, use `p2ai run`:

```bash
p2ai run -e GH_TOKEN='GitHub Token' -- gh repo list
p2ai run -e DB='Postgres Prod' -- psql
p2ai run -e A='AWS Key' -e B='AWS Secret' -- aws s3 ls
p2ai run -e USR='Service'::UserName -- some-tool   # specific attribute
```

`p2ai run` forks, exports the var only inside the child's environment,
and execve's the target. The parent shell never holds the secret.
Same PID, signals propagate, exit codes propagate.

## Discovery

If the entry name is uncertain:

```bash
p2ai list <fuzzy-query>             # human-readable
p2ai list --json                    # parseable for tooling
```

## Clipboard hand-off (human paste only)

```bash
p2ai fetch "<entry>"                # → clipboard, auto-clear 30s
p2ai otp "<entry>"                  # current TOTP code → clipboard
```

## Storing new secrets

If the user provides a fresh secret (verbally or via clipboard):

```bash
p2ai add "<entry>" -u USER -p       # user types pw in their terminal
p2ai add "<entry>" -u USER -g       # auto-generate 24-char pw
```

## Session caching

To avoid Touch-ID for every call in a multi-step task:

```bash
p2ai unlock                         # one Touch-ID, 5min idle, 30min hard cap
# now p2ai run / fetch / list don't re-prompt
p2ai lock                           # clear cache when done
```

## Exit codes (parse for retry logic)

- 0   success
- 1   generic error
- 2   tool dependency missing (keepassxc-cli not in PATH)
- 3   entry not found / DB read error
- 130 SIGINT (user cancelled Touch-ID prompt)

## Debugging without leaks

Never run raw `keepassxc-cli show` — it dumps secrets to stdout.
Use a `p2ai run` boolean check instead:

```bash
p2ai run -e V='Entry'::Notes -- bash -c 'grep -q "marker" <<<"$V" && echo OK || echo MISSING'
```
PROMPT
}

cmd_gtoken() {
  local entry="" scope="https://www.googleapis.com/auth/cloud-platform" mode="pbcopy"
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --scope|-s)   scope="$2"; shift 2 ;;
      --print|-p)   die "--print removed. Use 'p2ai run -e VAR=\"sa-entry\" -- <cmd>' or default pbcopy." ;;
      --export|-e)  die "--export removed (transcript-leak risk). Use 'p2ai gtoken' default pbcopy, or write a tiny wrapper that fetches and execs the cmd in one shot." ;;
      --pbcopy|-c)  mode="pbcopy"; shift ;;
      -h|--help)
        cat <<USAGE
p2ai gtoken <sa-entry> [options]
  Mint a Google OAuth access token from a Service-Account JSON entry.
  SA JSON must be in the entry's Notes field (a {...} block).
  --scope, -s SCOPE   default: cloud-platform. Aliases: drive, drive.readonly,
                      gmail, sheets, calendar, etc. Full URL also accepted.
  --pbcopy, -c        token to clipboard, auto-clear after \$P2AI_CLEAR_SECONDS (default)
USAGE
        return 0 ;;
      -*) die "unknown gtoken flag: $1" ;;
      *)  [[ -z "$entry" ]] && entry="$1" || die "extra arg: $1"; shift ;;
    esac
  done
  [[ -n "$entry" ]] || die "usage: p2ai gtoken <sa-entry> [--scope X] [--pbcopy]"

  # Resolve scope shortcuts to full URL
  case "$scope" in
    https://*) ;;
    drive)               scope="https://www.googleapis.com/auth/drive" ;;
    drive.readonly)      scope="https://www.googleapis.com/auth/drive.readonly" ;;
    gmail)               scope="https://www.googleapis.com/auth/gmail.readonly" ;;
    sheets)              scope="https://www.googleapis.com/auth/spreadsheets" ;;
    calendar)            scope="https://www.googleapis.com/auth/calendar" ;;
    cloud-platform|cloud) scope="https://www.googleapis.com/auth/cloud-platform" ;;
    *) scope="https://www.googleapis.com/auth/$scope" ;;
  esac

  command -v gcloud >/dev/null 2>&1 || die "gcloud CLI not found (https://cloud.google.com/sdk/docs/install)"

  require_db
  local kpcli; kpcli=$(resolve_kpcli)

  # 1. Fetch SA Notes inline — value stays in this shell's RAM, never stdout
  local master; master=$(fetch_master "$(p2ai_reason fetch "$entry")") || die "auth failed"
  local notes
  notes=$(printf '%s' "$master" | "$kpcli" show -s -a Notes "$P2AI_DB" "$entry" 2>/dev/null) || die "could not fetch '$entry' Notes attr"
  master=""
  [[ -n "$notes" ]] || die "Notes empty for entry '$entry'"

  # 2. Extract first {...} JSON block, validate, send to gcloud via tmpfile.
  #    gcloud requires a key-file path — we minimise exposure: mode 600, in
  #    a private tmpdir, shredded on EXIT.
  local tmpdir; tmpdir=$(mktemp -d -t p2ai-gtoken)
  chmod 700 "$tmpdir"
  trap "rm -rf -P '$tmpdir' 2>/dev/null" EXIT
  local json="$tmpdir/sa.json"

  # Pipe Notes via stdin so the SA-JSON never lands in argv (visible in `ps`)
  P2AI_NOTES="$notes" python3 - <<'PY' > "$json" 2>/dev/null
import os, re, json, sys
raw = os.environ.get("P2AI_NOTES", "")
m = re.search(r'\{[\s\S]*\}', raw)
if not m: sys.exit(1)
try:
    obj = json.loads(m.group(0))
    if 'private_key' not in obj or 'client_email' not in obj: sys.exit(2)
    json.dump(obj, sys.stdout)
except Exception:
    sys.exit(3)
PY
  notes=""
  [[ -s "$json" ]] || die "could not extract SA JSON from '$entry' Notes (need {...} with private_key + client_email)"
  chmod 600 "$json"

  # 3. Activate SA + mint access token. gcloud writes the token to stdout of
  #    its own subprocess — we capture it into a local var so it never reaches
  #    our caller's stdout.
  CLOUDSDK_PYTHON_SUPPRESS_WARNINGS=1 gcloud auth activate-service-account --key-file="$json" --quiet >/dev/null 2>&1 \
    || die "gcloud auth activate-service-account failed"
  local token
  token=$(CLOUDSDK_PYTHON_SUPPRESS_WARNINGS=1 gcloud auth print-access-token --scopes="$scope" 2>/dev/null) \
    || die "gcloud print-access-token failed (scope: $scope)"
  token="${token//$'\n'/}"
  [[ -n "$token" ]] || die "empty token returned"

  # 4. Output: pbcopy only — no stdout, no env exposure
  printf '%s' "$token" | pbcopy
  printf 'p2ai: gtoken (%s) in clipboard, auto-clear in %ss.\n' "$scope" "$P2AI_CLEAR_SECONDS" >&2
  ( sleep "$P2AI_CLEAR_SECONDS"; if [[ "$(pbpaste)" == "$token" ]]; then printf '' | pbcopy; fi ) >/dev/null 2>&1 &
  disown
  token=""
}

cmd_attachment() {
  local entry="" name="" outfile="" mode=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -o|--output)  outfile="${2:?}"; mode="file"; shift 2 ;;
      --print|-p)   die "--print removed. Use -o FILE (any) or --pbcopy (text only)." ;;
      --export|-e)  die "--export removed (transcript-leak risk). Use -o FILE for files or --pbcopy for text." ;;
      --pbcopy|-c)  mode="pbcopy"; shift ;;
      -h|--help)
        cat <<USAGE
p2ai attachment <entry> [<attachment-name>] [options]
  no name              → list attachment names (metadata only)
  <name> -o FILE       → export to file (binary or text)
  <name> --pbcopy      → copy text content to clipboard (default for text, auto-clear)
USAGE
        return 0 ;;
      -*) die "unknown attachment flag: $1" ;;
      *)  if [[ -z "$entry" ]]; then entry="$1"
          elif [[ -z "$name" ]]; then name="$1"
          else die "extra arg: $1"; fi
          shift ;;
    esac
  done
  [[ -n "$entry" ]] || die "usage: p2ai attachment <entry> [<name>] [-o FILE | --pbcopy]"
  require_db
  local kpcli; kpcli=$(resolve_kpcli)
  local master; master=$(fetch_master "$(p2ai_reason attachment "$entry")") || die "auth failed"

  if [[ -z "$name" ]]; then
    # List attachments
    printf '%s\n' "$master" | "$kpcli" show --show-attachments "$P2AI_DB" "$entry" 2>/dev/null \
      | awk '/^Attachments:/{f=1; next} f && /^[[:space:]]+/{print substr($0, index($0,$1))}'
    master=""
    return 0
  fi

  # Default for named attachment fetch: pbcopy (text only, never blind stdout)
  [[ -z "$mode" ]] && mode="pbcopy"

  if [[ "$mode" == "file" ]]; then
    printf '%s\n' "$master" | "$kpcli" attachment-export "$P2AI_DB" "$entry" "$name" "$outfile" 2>&1 | tail -1
    master=""
    [[ -r "$outfile" ]] && printf 'p2ai: saved → %s (%s bytes)\n' "$outfile" "$(wc -c < "$outfile" | tr -d ' ')" >&2
    return 0
  fi

  # In-memory fetch (text path)
  local content
  content=$(printf '%s\n' "$master" | "$kpcli" attachment-export --stdout "$P2AI_DB" "$entry" "$name" 2>/dev/null) || die "attachment '$name' not found in '$entry'"
  master=""
  [[ -n "$content" ]] || die "attachment '$name' empty"

  # Refuse binary content for clipboard
  if printf '%s' "${content:0:8192}" | LC_ALL=C grep -q $'\0'; then
    die "attachment '$name' is binary — use -o FILE to save (clipboard is text-only)"
  fi

  printf '%s' "$content" | pbcopy
  printf 'p2ai: attachment %s/%s in clipboard, auto-clear in %ss.\n' "$entry" "$name" "$P2AI_CLEAR_SECONDS" >&2
  ( sleep "$P2AI_CLEAR_SECONDS"; if [[ "$(pbpaste)" == "$content" ]]; then printf '' | pbcopy; fi ) >/dev/null 2>&1 &
  disown
}

cmd_add() {
  local entry="" user="" url="" notes="" gen_len="" prompt_pw=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -u|--username)  user="${2:?}"; shift 2 ;;
      --url)          url="${2:?}"; shift 2 ;;
      --notes|--note) notes="${2:?}"; shift 2 ;;
      -g|--generate)  gen_len="${2:-24}"
                      [[ "$gen_len" =~ ^[0-9]+$ ]] || { gen_len=24; shift 1; continue; }
                      shift 2 ;;
      -p|--password)  prompt_pw=1; shift ;;
      -h|--help)
        cat <<USAGE
p2ai add <entry> [options]
  -u, --username USER     username for entry
  --url URL               URL field
  --notes TEXT            notes field
  -g, --generate [LEN]    auto-generate password (default length 24)
  -p, --password          prompt interactively for password (hidden)
Default if neither -g nor -p: -g 24.
USAGE
        return 0 ;;
      -*) die "unknown add flag: $1" ;;
      *)  [[ -z "$entry" ]] && entry="$1" || die "extra arg: $1"; shift ;;
    esac
  done
  [[ -n "$entry" ]] || die "usage: p2ai add <entry> [-u user] [-g [LEN]] [-p] [--url URL] [--notes TEXT]"
  require_db
  [[ -w "$P2AI_DB" ]] || die "DB not writable: $P2AI_DB"
  local kpcli; kpcli=$(resolve_kpcli)

  # Default: auto-generate 24-char password
  if [[ -z "$gen_len" && $prompt_pw -eq 0 ]]; then
    gen_len=24
  fi

  local master; master=$(fetch_master "$(p2ai_reason add "$entry")") || die "auth failed"

  # Build keepassxc-cli args
  local args=(add)
  [[ -n "$user" ]]  && args+=(-u "$user")
  [[ -n "$url" ]]   && args+=(--url "$url")
  [[ -n "$notes" ]] && args+=(--notes "$notes")
  if [[ -n "$gen_len" ]]; then
    args+=(-g -L "$gen_len" -l -U -n -s --exclude-similar)
  elif [[ $prompt_pw -eq 1 ]]; then
    args+=(-p)
  fi
  args+=("$P2AI_DB" "$entry")

  # Run keepassxc-cli — master via stdin, entry-pwd prompt on TTY (if -p)
  if printf '%s\n' "$master" | "$kpcli" "${args[@]}"; then
    master=""
    printf 'p2ai: added "%s" to %s\n' "$entry" "$P2AI_DB" >&2
  else
    master=""
    die "keepassxc-cli add failed"
  fi
}

cmd_rm() {
  local entry="" force=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -f|--force) force=1; shift ;;
      -h|--help)
        cat <<USAGE
p2ai rm <entry> [-f]
  Remove an entry from the database. Touch-ID required.
  -f, --force   skip confirmation prompt
USAGE
        return 0 ;;
      -*) die "unknown rm flag: $1" ;;
      *)  [[ -z "$entry" ]] && entry="$1" || die "extra arg: $1"; shift ;;
    esac
  done
  [[ -n "$entry" ]] || die "usage: p2ai rm <entry> [-f]"
  require_db
  [[ -w "$P2AI_DB" ]] || die "DB not writable: $P2AI_DB"
  local kpcli; kpcli=$(resolve_kpcli)

  if [[ $force -eq 0 ]]; then
    printf 'Delete entry "%s" from %s? [y/N] ' "$entry" "$P2AI_DB" >&2
    local ans; read -r ans
    [[ "$ans" =~ ^[yY]$ ]] || { printf 'p2ai: cancelled.\n' >&2; return 1; }
  fi

  local master; master=$(fetch_master "$(p2ai_reason rm "$entry")") || die "auth failed"
  if printf '%s\n' "$master" | "$kpcli" rm "$P2AI_DB" "$entry"; then
    master=""
    printf 'p2ai: removed "%s"\n' "$entry" >&2
    # Best-effort: invalidate any cached entries with this prefix
    if agent_running; then
      agent_send "INVALIDATE $entry" >/dev/null 2>&1 || true
    fi
  else
    master=""
    die "keepassxc-cli rm failed"
  fi
}

cmd_edit() {
  local entry="" user="" url="" notes="" title="" gen_len="" prompt_pw=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -u|--username)  user="${2:?}"; shift 2 ;;
      --url)          url="${2:?}"; shift 2 ;;
      --notes|--note) notes="${2:?}"; shift 2 ;;
      -t|--title)     title="${2:?}"; shift 2 ;;
      -g|--generate)  gen_len="${2:-24}"
                      [[ "$gen_len" =~ ^[0-9]+$ ]] || { gen_len=24; shift 1; continue; }
                      shift 2 ;;
      -p|--password)  prompt_pw=1; shift ;;
      -h|--help)
        cat <<USAGE
p2ai edit <entry> [options]
  -u, --username USER     update username
  --url URL               update URL
  --notes TEXT            update notes
  -t, --title NEW         rename entry (changes title)
  -g, --generate [LEN]    rotate password (default length 24)
  -p, --password          prompt interactively for new password
USAGE
        return 0 ;;
      -*) die "unknown edit flag: $1" ;;
      *)  [[ -z "$entry" ]] && entry="$1" || die "extra arg: $1"; shift ;;
    esac
  done
  [[ -n "$entry" ]] || die "usage: p2ai edit <entry> [-u USER] [--url URL] [--notes TXT] [-t TITLE] [-g [LEN]] [-p]"
  [[ -n "$user$url$notes$title$gen_len" || $prompt_pw -eq 1 ]] || die "nothing to change — pass at least one option"
  require_db
  [[ -w "$P2AI_DB" ]] || die "DB not writable: $P2AI_DB"
  local kpcli; kpcli=$(resolve_kpcli)

  local args=(edit)
  [[ -n "$user" ]]   && args+=(-u "$user")
  [[ -n "$url" ]]    && args+=(--url "$url")
  [[ -n "$notes" ]]  && args+=(--notes "$notes")
  [[ -n "$title" ]]  && args+=(-t "$title")
  if [[ -n "$gen_len" ]]; then
    args+=(-g -L "$gen_len" -l -U -n -s --exclude-similar)
  elif [[ $prompt_pw -eq 1 ]]; then
    args+=(-p)
  fi
  args+=("$P2AI_DB" "$entry")

  local master; master=$(fetch_master "$(p2ai_reason edit "$entry")") || die "auth failed"
  if printf '%s\n' "$master" | "$kpcli" "${args[@]}"; then
    master=""
    printf 'p2ai: edited "%s"\n' "$entry" >&2
    # Invalidate cached values (password may have rotated)
    if agent_running; then
      agent_send "INVALIDATE $entry" >/dev/null 2>&1 || true
    fi
  else
    master=""
    die "keepassxc-cli edit failed"
  fi
}

cmd_mv() {
  local entry="" group=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -h|--help)
        cat <<USAGE
p2ai mv <entry> <group>
  Move an entry to a different group.
USAGE
        return 0 ;;
      -*) die "unknown mv flag: $1" ;;
      *)  if [[ -z "$entry" ]]; then entry="$1"
          elif [[ -z "$group" ]]; then group="$1"
          else die "extra arg: $1"; fi
          shift ;;
    esac
  done
  [[ -n "$entry" && -n "$group" ]] || die "usage: p2ai mv <entry> <group>"
  require_db
  [[ -w "$P2AI_DB" ]] || die "DB not writable: $P2AI_DB"
  local kpcli; kpcli=$(resolve_kpcli)

  local master; master=$(fetch_master "$(p2ai_reason mv "$entry")") || die "auth failed"
  if printf '%s\n' "$master" | "$kpcli" mv "$P2AI_DB" "$entry" "$group"; then
    master=""
    printf 'p2ai: moved "%s" → %s\n' "$entry" "$group" >&2
    if agent_running; then
      agent_send "INVALIDATE $entry" >/dev/null 2>&1 || true
    fi
  else
    master=""
    die "keepassxc-cli mv failed"
  fi
}

cmd_otp() {
  local entry=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --print|-p)  die "--print removed (transcript-leak risk). Default pbcopy is the only output mode." ;;
      --export|-e) die "--export removed (transcript-leak risk). TOTP codes are short-lived, default pbcopy is sufficient." ;;
      -h|--help)
        cat <<USAGE
p2ai otp <entry>
  Fetch current TOTP code for an entry.
  Output: pbcopy with auto-clear after \$P2AI_CLEAR_SECONDS.
USAGE
        return 0 ;;
      -*) die "unknown otp flag: $1" ;;
      *)  [[ -z "$entry" ]] && entry="$1" || die "extra arg: $1"; shift ;;
    esac
  done
  [[ -n "$entry" ]] || die "usage: p2ai otp <entry>"
  require_db
  local kpcli; kpcli=$(resolve_kpcli)

  local master; master=$(fetch_master "$(p2ai_reason otp "$entry")") || die "auth failed"
  local code
  code=$(printf '%s\n' "$master" | "$kpcli" show -s -t "$P2AI_DB" "$entry" 2>/dev/null) || die "no TOTP for entry: $entry"
  master=""
  [[ -n "$code" ]] || die "TOTP empty (entry has no OTP configured)"
  code=$(printf '%s' "$code" | tail -1)

  printf '%s' "$code" | pbcopy
  printf 'p2ai: TOTP for %s in clipboard, auto-clear in %ss.\n' "$entry" "$P2AI_CLEAR_SECONDS" >&2
  ( sleep "$P2AI_CLEAR_SECONDS"; if [[ "$(pbpaste)" == "$code" ]]; then printf '' | pbcopy; fi ) >/dev/null 2>&1 &
  disown
}

# Parse dotenv-style file. Lines: KEY=value, KEY='value', KEY="value".
# Comments (#) and blank lines ignored. Appends to the array named in $2.
_p2ai_load_env_file() {
  local file="$1" arrayname="$2"
  [[ -r "$file" ]] || die "env-file not readable: $file"
  local line key val
  while IFS= read -r line || [[ -n "$line" ]]; do
    # Strip leading/trailing whitespace, skip comments + blank
    line="${line#"${line%%[![:space:]]*}"}"
    line="${line%"${line##*[![:space:]]}"}"
    [[ -z "$line" || "$line" =~ ^# ]] && continue
    if [[ "$line" =~ ^([A-Za-z_][A-Za-z0-9_]*)=(.*)$ ]]; then
      key="${BASH_REMATCH[1]}"
      val="${BASH_REMATCH[2]}"
      # Strip surrounding single or double quotes if present
      if [[ "$val" =~ ^\'(.*)\'$ ]]; then
        val="${BASH_REMATCH[1]}"
      elif [[ "$val" =~ ^\"(.*)\"$ ]]; then
        val="${BASH_REMATCH[1]}"
      fi
      [[ -n "$val" ]] || die "env-file '$file': $key has empty value"
      eval "$arrayname+=(\"\$key=\$val\")"
    else
      die "env-file '$file' line not parseable: $line"
    fi
  done < "$file"
}

cmd_run() {
  # p2ai run [-e VAR=entry[::attr]] [...] -- <command> [args...]
  #
  # Fetch one or more secrets, fork a subshell, export them in the subshell
  # only, and execve the target command. The parent shell never holds the
  # secrets in its environment, eliminating the env-leak window that the
  # eval+export+unset pattern leaves open between the eval and the unset.
  #
  # Format: VAR=entry           → fetch Password attribute of entry
  #         VAR=entry::Username → fetch a specific attribute
  local -a env_pairs=()
  local -a cmd=()
  local saw_dashdash=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -e|--env)       env_pairs+=("${2:?}"); shift 2 ;;
      -f|--env-file)  _p2ai_load_env_file "${2:?}" env_pairs; shift 2 ;;
      --)             shift; cmd=("$@"); saw_dashdash=1; break ;;
      -h|--help)
        cat <<USAGE
p2ai run [-e VAR=entry[::attr]] [-f FILE] [...] -- <command> [args...]
  Fetch secret(s) and run <command> with them in its environment only.
  The parent shell never sees the secrets — no env-leak window.

  -e, --env VAR=entry            map env-var VAR to entry's Password
  -e, --env VAR=entry::Notes     map to a specific attribute
  -f, --env-file FILE            load mappings from a dotenv file:
                                   # comment
                                   GH_TOKEN='Group/GitHub Token'
                                   DB_PASS="Prod/Postgres"
                                   AWS_KEY=Aws/Prod::UserName

Examples:
  p2ai run -e GH_TOKEN='GitHub Token' -- gh repo list
  p2ai run -f .p2ai.env -- ./deploy.sh
  p2ai run -e API='Stripe'::Notes -- node scripts/import.js

Note: arguments after -- are passed to the target command unchanged.
Shell builtins (cd, alias) won't work after -- — wrap with bash -c "...".
USAGE
        return 0 ;;
      -*) die "unknown run flag: $1 (try: p2ai run -h)" ;;
      *)  die "unexpected positional '$1' — separate command with --" ;;
    esac
  done
  [[ $saw_dashdash -eq 1 && ${#cmd[@]} -gt 0 ]] || die "usage: p2ai run [-e VAR=entry] -- <command> [args...]"

  if [[ ${#env_pairs[@]} -eq 0 ]]; then
    # No secrets requested — just exec the command, no fork
    exec "${cmd[@]}"
  fi

  require_db
  local kpcli; kpcli=$(resolve_kpcli)
  local master; master=$(fetch_master "$(p2ai_reason fetch run)") || die "auth failed"

  # Fetch every requested secret. Cache via agent if running.
  local -a env_kv=()
  local pair var rest entry attr secret cached
  for pair in "${env_pairs[@]}"; do
    [[ "$pair" == *=* ]] || die "invalid --env: $pair (expected VAR=entry[::attr])"
    var="${pair%%=*}"
    rest="${pair#*=}"
    [[ -n "$var" && -n "$rest" ]] || die "invalid --env: $pair"
    if [[ "$rest" == *::* ]]; then
      attr="${rest##*::}"
      entry="${rest%::*}"
    else
      attr="Password"
      entry="$rest"
    fi

    secret=""
    if agent_running; then
      cached=$(agent_send "GETENTRY ${entry}:${attr}")
      [[ -n "$cached" && "$cached" != "MISS" ]] && secret="$cached"
    fi
    if [[ -z "$secret" ]]; then
      secret=$(printf '%s' "$master" | "$kpcli" show -s -a "$attr" "$P2AI_DB" "$entry" 2>/dev/null) \
        || die "entry not found: $entry"
      [[ -n "$secret" ]] || die "empty value for $entry / $attr"
      if agent_running; then
        printf '%s' "$secret" | agent_send_with_body "PUTENTRY ${entry}:${attr}" >/dev/null 2>&1 || true
      fi
    fi
    env_kv+=("$var=$secret")
    secret=""
  done
  master=""

  # Use bash's one-shot env assignment + exec. The `VAR=val cmd` syntax
  # scopes the assignment to cmd's environment only (not the parent shell),
  # AND `exec` replaces our bash process with cmd — same PID.
  #
  # Why same-PID matters: signals (SIGINT, SIGTERM) sent to p2ai go straight
  # to cmd. No orphan processes when the user Ctrl+C's a long-running tool.
  # Why argv-safe: the assignments are bash-internal one-shot syntax, never
  # appear in /proc/PID/cmdline or `ps -p PID -o args`.
  local assignments=""
  local kv
  for kv in "${env_kv[@]}"; do
    assignments+=" $(printf '%q' "$kv")"
  done
  local cmd_str=""
  local c
  for c in "${cmd[@]}"; do
    cmd_str+=" $(printf '%q' "$c")"
  done
  eval "$assignments exec $cmd_str"
}

cmd_fetch() {
  local entry="" attr="Password" mode="pbcopy"
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --print|-p)
        die "--print removed (transcript-leak risk). Use 'p2ai run -e VAR=\"entry\" -- <cmd>'."
        ;;
      --out|-o)
        die "-o FILE removed for fetch (no-disk policy). Use 'p2ai run -e VAR=\"entry\" -- <cmd>'."
        ;;
      --export|-e)
        die "--export removed (transcript-leak risk in AI-agent shells). Use 'p2ai run -e VAR=\"entry\" -- <cmd>' — the secret enters only the cmd's environment, never the parent shell."
        ;;
      --attr|-a)    attr="${2:?}"; shift 2 ;;
      --no-clear|-n) mode="pbcopy-noclear"; shift ;;
      -h|--help)
        cat <<USAGE
p2ai fetch <entry> [--attr X] [--no-clear]
  Fetch a KeePass attribute, deliver via clipboard with auto-clear.
  --attr, -a NAME    attribute to fetch (default: Password)
  --no-clear, -n     skip auto-clear

  For tool injection use: p2ai run -e VAR="entry" -- <cmd>
USAGE
        return 0 ;;
      -*)           die "unknown flag: $1" ;;
      *)            [[ -z "$entry" ]] && entry="$1" || die "extra arg: $1"; shift ;;
    esac
  done
  [[ -n "$entry" ]] || die "usage: p2ai fetch <entry> [--attr X] [--no-clear]
  Default: pbcopy with auto-clear after \$P2AI_CLEAR_SECONDS.
  For tool injection use 'p2ai run -e VAR=\"entry\" -- <cmd>'."
  require_db
  local kpcli; kpcli=$(resolve_kpcli)

  local cache_key="${entry}:${attr}"
  local secret=""

  if agent_running; then
    local cached; cached=$(agent_send "GETENTRY $cache_key")
    if [[ -n "$cached" && "$cached" != "MISS" ]]; then
      secret="$cached"
    fi
  fi
  if [[ -z "$secret" ]]; then
    local reason; reason=$(p2ai_reason fetch "$entry")
    local master; master=$(fetch_master "$reason") || die "auth failed"
    secret=$(printf '%s' "$master" | "$kpcli" show -s -a "$attr" "$P2AI_DB" "$entry" 2>/dev/null) || die "entry not found: $entry"
    master=""
    [[ -n "$secret" ]] || die "empty value for $entry / $attr"
    if agent_running; then
      printf '%s' "$secret" | agent_send_with_body "PUTENTRY $cache_key" >/dev/null 2>&1 || true
    fi
  fi

  case "$mode" in
    pbcopy)
      printf '%s' "$secret" | pbcopy
      printf 'p2ai: %s/%s in clipboard, auto-clear in %ss.\n' "$entry" "$attr" "$P2AI_CLEAR_SECONDS" >&2
      (
        sleep "$P2AI_CLEAR_SECONDS"
        if [[ "$(pbpaste)" == "$secret" ]]; then
          printf '' | pbcopy
        fi
      ) >/dev/null 2>&1 &
      disown
      ;;
    pbcopy-noclear)
      printf '%s' "$secret" | pbcopy
      printf 'p2ai: %s/%s in clipboard.\n' "$entry" "$attr" >&2
      ;;
  esac
}

main() {
  local cmd="${1:-}"; [[ $# -gt 0 ]] && shift || true
  case "$cmd" in
    setup)                  cmd_setup "$@" ;;
    run|exec)               cmd_run "$@" ;;
    fetch|f|get)            cmd_fetch "$@" ;;
    add|new)                cmd_add "$@" ;;
    rm|remove|del|delete)   cmd_rm "$@" ;;
    edit|update)            cmd_edit "$@" ;;
    mv|move|rename)         cmd_mv "$@" ;;
    otp|totp|2fa)           cmd_otp "$@" ;;
    attachment|attach|att)  cmd_attachment "$@" ;;
    gtoken|gcp-token)       cmd_gtoken "$@" ;;
    list|ls|search)         cmd_list "$@" ;;
    system-prompt|prompt|rules) cmd_system_prompt "$@" ;;
    unlock|u)         cmd_unlock "$@" ;;
    lock|l)           cmd_lock "$@" ;;
    status|s)         cmd_status "$@" ;;
    config|cfg)       cmd_config ;;
    -h|--help|help|"")
      sed -n '5,32p' "$0" | sed 's/^# \{0,1\}//'
      ;;
    *) die "unknown command: $cmd (try: p2ai -h)" ;;
  esac
}

main "$@"
